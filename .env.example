# =================================================================
# EventLink Production Environment Configuration
# =================================================================

# 1. Server Configuration
NODE_ENV=development
PORT=3001
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Frontend API URL (Vite; leave empty to use the local/hosted default)
VITE_API_BASE_URL=http://localhost:3001

# 2. Database Persistence (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/eventlink_db

# 3. Transactional Gmail SMTP Email Engine (Nodemailer)
# Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_gmail_app_password

# 4. Fiat Payment Gateways (Stripe & Flutterwave)
STRIPE_SECRET_KEY=sk_test_51Pxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_stripe_webhook_secret_key_2026

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_HASH=flw_sec_hash_eventlink_2026

# 5. Stellar Blockchain & Soroban Smart Contracts
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Soroban Ticket NFT Contract Address on Stellar
